{
  "expo": {
    "name": "경조금고",
    "slug": "event-balance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eventbalance.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lazyfactory.gyeongjovault",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366F1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["RECEIVE_BOOT_COMPLETED"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-contacts",
        {
          "contactsPermission": "경조사비 기록 시 연락처에서 이름과 전화번호를 불러오기 위해 사용합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bc0db43d-bdd1-4ff8-ac46-5d1181f7b2d1"
      }
    },
    "owner": "event-balance"
  }
}
